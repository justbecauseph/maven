  <modelVersion>4.0.0</modelVersion>
  <groupId>town.lampas</groupId>
  <artifactId>haruhi</artifactId>
  <version>0.3.1</version>
  <name>Haruhi</name>
  <description>Scriptable NPCs for Fabric: data-driven dialogue graphs, a visual-novel dialogue screen, Blockbench (GeckoLib) models and per-character dialogue flags.</description>
  <url>https://github.com/justbecauseph/haruhi</url>
  <licenses>
    <license>
      <name>Mozilla Public License 2.0</name>
      <url>https://www.mozilla.org/MPL/2.0/</url>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:https://github.com/justbecauseph/haruhi.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/justbecauseph/haruhi.git</developerConnection>
    <url>https://github.com/justbecauseph/haruhi</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>net.fabricmc</groupId>
      <artifactId>fabric-loader</artifactId>
      <version>0.19.3</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>net.fabricmc.fabric-api</groupId>
      <artifactId>fabric-api</artifactId>
      <version>0.158.0+26.2</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.7</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>7.1.0</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
